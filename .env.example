# NeuraOS Server Configuration
# ----------------------------

# Primary AI Provider: Ollama (Local, offline, free, no API key required)
# Switch active provider by setting AI_PROVIDER=ollama
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Secondary / Cloud AI Provider: Groq (Optional, ultra-fast cloud inference with auto-fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Legacy AI Provider: Google Gemini Developer API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# News & Weather
NEWS_API_KEY=
WEATHER_LAT=17.3850
WEATHER_LON=78.4867
WEATHER_CITY=HYDERABAD, IN

# Server Network Settings
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Local speech recognition (free, offline Whisper)
LOCAL_WHISPER_MODEL=base.en
# VOICE_PYTHON=C:\path\to\python.exe

# --- Gmail Email Agent ---
# Default: reads Gmail through Chrome browser agent with local processing.
# Optional API mode (official Gmail API, read-only OAuth):
# GMAIL_MODE=api
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
